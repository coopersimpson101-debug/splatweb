{
  "name": "splatweb",
  "version": "0.1.0",
  "description": "A hand-written Gaussian splatting renderer for WebGPU: streaming .ply/.splat loader, compute preprocessing with EWA projection, GPU radix sort, and premultiplied alpha splat rasterization.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gpu": "vitest run tests/gpu.test.ts",
    "render": "vite-node scripts/headless.ts -- --out docs/images/demo.png",
    "bench": "vite-node scripts/headless.ts -- --bench",
    "capture:gif": "vite-node scripts/capture_gif.ts -- --out docs/images/orbit.gif",
    "banner": "vite-node scripts/make_banner.ts",
    "live:capture": "vite-node scripts/live_capture.ts --"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "gifenc": "^1.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "webgpu": "^0.6.2"
  }
}
